
-- =====================================================
-- 01. TOTAL REVENUE
-- Business Question:
-- What is the total revenue generated from all sales?
-- =====================================================

SELECT 
    SUM(Revenue) AS Total_Revenue
FROM apple_sales;

-- =====================================================
-- 02. TOTAL ORDERS
-- How many unique orders were placed?
-- =====================================================

SELECT COUNT(DISTINCT Order_ID) AS Total_Orders
FROM apple_sales;

-- =====================================================
-- 03. TOTAL UNITS SOLD
-- How many total units were sold?
-- =====================================================

SELECT SUM(Quantity) AS Total_Units_Sold
FROM apple_sales;

-- =====================================================
-- 04. AVERAGE ORDER VALUE
-- What is the average revenue generated per order?
-- =====================================================

SELECT 
    SUM(Revenue) / COUNT(DISTINCT Order_ID) AS Average_Order_Value
FROM apple_sales;

-- =====================================================
-- 05. REVENUE BY YEAR
-- How has total revenue changed across different years?
-- =====================================================

SELECT 
    Year,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Year
ORDER BY Year;

-- =====================================================
-- 06. REVENUE BY QUARTER
-- How does revenue vary across different quarters of each year?
-- =====================================================

SELECT 
    Year,
    Quarter,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Year, Quarter
ORDER BY Year, Quarter;

-- =====================================================
-- 07. REVENUE BY COUNTRY
-- Which countries generate the highest total revenue?
-- =====================================================

SELECT 
    Country,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Country
ORDER BY Total_Revenue DESC;

-- =====================================================
-- 08. TOP 10 COUNTRIES BY REVENUE
-- Which are the top 10 countries based on total revenue?
-- =====================================================

SELECT 
    Country,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Country
ORDER BY Total_Revenue DESC
LIMIT 10;

-- =====================================================
-- 09. REVENUE BY PRODUCT CATEGORY
-- Which product categories generate the highest total revenue?
-- =====================================================

SELECT 
    Category,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Category
ORDER BY Total_Revenue DESC;

-- =====================================================
-- 10. UNTIS SOLS BY PRODUCT CATEGORY
-- Which product categories have the highest number of units sold?
-- =====================================================

SELECT 
    Category,
    SUM(Quantity) AS Units_Sold
FROM apple_sales
GROUP BY Category
ORDER BY Units_Sold DESC;

-- =====================================================
-- 11. REVENUE BY SALES CHANNEL
-- Which sales channels generate the highest revenue?
-- =====================================================

SELECT 
    Sales_Channel,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Sales_Channel
ORDER BY Total_Revenue DESC;

-- =====================================================
-- 12. REVENUE BY CUSTOMER SEGMENT
-- Which customer segments contribute the most revenue?
-- =====================================================

SELECT 
    Customer_Segment,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Customer_Segment
ORDER BY Total_Revenue DESC;

-- =====================================================
-- 13. REVENUE BY PAYMENT METHOD
-- Which payment methods are associated with the highest revenue?
-- =====================================================

SELECT 
    Payment_Method,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Payment_Method
ORDER BY Total_Revenue DESC;

-- =====================================================
-- 14. REVENUE BY CUSTOMER AGE GROUP
-- Which customer age groups generate the highest revenue?
-- =====================================================

SELECT 
    Age_Group,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Age_Group
ORDER BY Total_Revenue DESC;

-- =====================================================
-- 15. RETURN STATUS ANALYSIS
-- How do orders and revenue vary by return status?
-- =====================================================

SELECT 
    Return_Status,
    COUNT(DISTINCT Order_ID) AS Total_Orders,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Return_Status;

-- =====================================================
-- 16. REVENUE BY COUNTRY AND CATEGORY
-- Which product categories generate the most revenue within each country?
-- =====================================================

SELECT 
    Country,
    Category,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Country, Category
ORDER BY Country, Total_Revenue DESC;

-- =====================================================
-- 17. MONTHLY REVENUE
-- How does monthly revenue change over time?
-- =====================================================

SELECT 
    Year,
    Month,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Year, Month
ORDER BY Year, Month;

-- =====================================================
-- 18. HIGHEST REVENUE-GENERATING CATEGORY IN EACH YEAR
-- Which product category generates the highest revenue in each year?
-- =====================================================

SELECT 
    Year,
    Category,
    SUM(Revenue) AS Total_Revenue
FROM apple_sales
GROUP BY Year, Category
ORDER BY Year, Total_Revenue DESC;

-- =====================================================
-- 19. ORDERS BY COUNTRY
-- Which countries have the highest number of orders?
-- =====================================================

SELECT 
    Country,
    COUNT(DISTINCT Order_ID) AS Total_Orders
FROM apple_sales
GROUP BY Country
ORDER BY Total_Orders DESC;

-- =====================================================
-- 20. AVERAGE ORDER VALUE BY COUNTRY
-- Which countries have the highest average order value?
-- =====================================================

SELECT 
    Country,
    SUM(Revenue) / COUNT(DISTINCT Order_ID) AS Average_Order_Value
FROM apple_sales
GROUP BY Country
ORDER BY Average_Order_Value DESC;
